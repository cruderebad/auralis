{
  "version": 2,
  "functions": {
    "server.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/googlebf993bfc0c147e22.html",
      "destination": "/googlebf993bfc0c147e22.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
